{
  "name": "moduvita-platform",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moduvita/web",
    "build": "npm run build --workspace @moduvita/web",
    "build:pages": "node scripts/build-pages-preview.mjs",
    "start": "npm run start --workspace @moduvita/web",
    "check": "npm run check --workspace @moduvita/web && npm run test:db",
    "test:db": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
